# FormFix - Streamlit version
__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store

# Analysis artefacts (evaluation exports; regenerated per run)
analysis_results/

# The MediaPipe model is fetched with scripts/download_pose_model.py
static/assets/models/*.task

# Local development clips
_dev_test_clips/
test_videos/

# The original HEVC exports of the reference clips. The versions the app
# serves are H.264 (browsers other than Safari will not play HEVC); these are
# kept locally as the masters, not shipped.
static/assets/videos/_source_hevc/

# Labelled evaluation recordings. The clips stay on my machine; the manifest
# and the results of the run are tracked, because the write-up in docs/ quotes
# numbers from them.
evaluation/*.mp4
evaluation/*.mov

.pytest_cache/
.ruff_cache/

# Personal reference sheets I wrote for myself while preparing the viva.
# Not part of the submission and not useful to anyone cloning the project.
questions/

# Backup archive from a local refactor.
*.tgz
